CORTEX_AGENT_DATABASE=
CORTEX_AGENT_SCHEMA=
CORTEX_AGENT_NAME=
# Optional warehouse specifically for Cortex Agent queries; takes precedence above.
CORTEX_AGENT_WAREHOUSE=

STREAMLIT_SERVER_PORT=8502